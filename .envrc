# shellcheck shell=bash
# direnv: keep the project copy of the mod in step with this checkout, with no
# manual step. Run `direnv allow` once per checkout (each worktree is its own).
#
# On cd into the checkout: copy the mod to .claude/skills/artifact-tracking-dev when
# the copy is missing or stale, then start a background watcher. The watcher copies
# again when a plugin file changes, also when claude edits it. When no process (shell,
# claude) has its cwd in the checkout any more, it runs uninstall-local and exits.
# Details: scripts/dev/install-local-watch.sh. Log: .git/install-local-watch.log.

watcher=scripts/dev/install-local-watch.sh

if "$watcher" install "$PWD"; then
	"$watcher" start "$PWD"
else
	log_error "install-local failed. See scripts/dev/install-local-watch.sh."
fi
