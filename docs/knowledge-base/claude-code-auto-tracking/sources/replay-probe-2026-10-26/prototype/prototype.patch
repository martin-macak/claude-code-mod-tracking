+// Issue #202: a cold `--resume` fires no hook for the old calls, so the transcript is read back and the proofs of the PRs
+// the earlier process created are rebuilt. The shapes are the stored results of a cold-resumed session of Claude Code
+// 2.1.310 (design study of #202, probe S1): `result` is the record of the live call, with its `gitOperation`.
+const USE_AT = 'https://github.com/octo/demo/pull'
+/** An assistant message with one answered Bash use, as `$.session.messages()` gives it after a resume. */
+const bashUse = (
+  id: string,
+  command: string,
+  answer: { result?: unknown; text?: string; isError?: true },
+): SessionRow =>
+  ({
+    role: 'assistant',
+    text: '',
+    toolUses: [{ tool_use_id: id, tool: 'Bash', input: { command, description: 'x' }, ...answer }],
+  }) as SessionRow
+const plain = (stdout: string, gitOperation?: unknown) => ({
+  result: { stdout, stderr: '', interrupted: false, ...(gitOperation !== undefined ? { gitOperation } : {}) },
+  text: stdout,
+})
+const CREATED_7 = plain(`${USE_AT}/7`, { pr: { number: 7, url: `${USE_AT}/7`, action: 'created' } })
+const CREATED_8 = plain(`${USE_AT}/8`, { pr: { number: 8, url: `${USE_AT}/8`, action: 'created' } })
+const NO_PR_USES: SessionRow[] = [
+  bashUse('t_view', 'gh pr view 7', plain('title: demo pr')),
+  bashUse('t_list', 'gh pr list', plain('7  demo pr  feat/x  OPEN')),
+  bashUse('t_fail', 'gh pr create --title x', {
+    result: 'Error: Exit code 1\nfake gh: a pull request for branch already exists',
+    text: 'Exit code 1\nfake gh: a pull request for branch already exists',
+    isError: true,
+  }),
+  bashUse('t_merge', 'gh pr merge 7 --squash', plain('Merged', { pr: { number: 7, action: 'merged' } })),
+  bashUse(
+    't_comment',
+    'gh pr comment 7',
+    plain(`${USE_AT}/7#c1`, { pr: { number: 7, url: `${USE_AT}/7`, action: 'commented' } }),
+  ),
+  bashUse('t_open', 'gh pr create --title y', { text: undefined }), // a call with no stored answer
+  bashUse('t_wt', 'git worktree add -q -b feat/x ../wt', plain('', { branch: { ref: 'x', action: 'merged' } })),
+]
+
